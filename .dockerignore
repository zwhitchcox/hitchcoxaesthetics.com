# Never ship local installs/builds into the image — the Docker stages install
# and build for Linux themselves. (Missing this file caused the 2026-07-06
# outage: COPY . . overwrote Linux node_modules with macOS arm64 binaries.)
node_modules
**/node_modules
build
server-build
.cache
.env
.env.*
*.log
test-results
playwright-report
coverage
review-qr-codes*
# Local working data — never needed in the image, and huge
processing-images-archive
processing-images
google-ads
candidates
reviews
downloads
.playwright-mcp
# Local financial credentials — must never ship in an image
.plaid-tokens.json
# .plaid-vendor-categories.json DOES ship: it is vendor-name -> category only
# (no credentials) and prod's P&L classification + fixed-bill amortization
# are rules-only without it (rent and retainers went unclassified).
.git
.github
.vscode
.claude
prisma/*.db
tests
mcp-test.log
